# ── Site ─────────────────────────────────────────────────────────────
# Public URL (used in emails and payment redirects). On Vercel this falls back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── Supabase (Project Settings → API) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Studio admin ─────────────────────────────────────────────────────
# Comma-separated emails that become admins when they sign in.
ADMIN_EMAILS=

# ── Demo mode ────────────────────────────────────────────────────────
# true = login codes shown on screen, messages only logged to the admin Outbox.
# Set to false before real clients use the app.
DEMO_MODE=true
# Private 8–12 digit code the admin types to sign in while DEMO_MODE=true
# (demo login codes are shown on screen for clients, never for admins).
DEMO_ADMIN_CODE=

# ── Payments: Stripe (optional; without it a mock checkout is used) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email: Resend (optional; without it messages go to the Outbox) ───
RESEND_API_KEY=
EMAIL_FROM="Re·Form Pilates <hello@yourdomain.com>"

# ── SMS: Twilio (optional) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Scheduler ────────────────────────────────────────────────────────
# Secret for GET /api/cron/tick (reminders + waitlist). Any long random string.
CRON_SECRET=
